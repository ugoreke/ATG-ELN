# dependencies and test output
node_modules/
test-results/
.DS_Store

# private to each person's copy: never commit notebook data or protocols
data/protocols/
data/entries/
data/voice.json
data/*.private.json

# local development notes
docs/
CLAUDE.local.md

# Claude Code: skills, agents and shared settings are tracked;
# everything else under .claude/ (settings.local.json, worktrees...) stays local
.claude/*
!.claude/skills/
!.claude/agents/
!.claude/settings.json

# scratch space: keep the folder, never its contents
scratch/*
!scratch/README.md

# backups of the notebook (the eln-backup skill): the whole database, never committed
backups/

# images: only the README demo is tracked
*.png
!demo/*.png

# recordings and speech models never belong in the repository
*.m4a
*.mp3
*.wav
*.caf
*.aac
*.ogg
*.flac
*.webm
*.bin
*.gguf
