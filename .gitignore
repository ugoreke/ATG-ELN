# dependencies and test output
node_modules/
test-results/
.DS_Store

# private to each person's copy: never commit notebook data or protocols
data/protocols/
data/entries/
data/voice.json
data/*.private.json

# local development notes and Claude Code project files
docs/
CLAUDE.local.md
.claude/

# scratch space: keep the folder, never its contents
scratch/*
!scratch/README.md

# images: only the README demo is tracked
*.png
!demo/*.png

# recordings and speech models never belong in the repository
*.m4a
*.mp3
*.wav
*.caf
*.aac
*.ogg
*.flac
*.webm
*.bin
*.gguf
